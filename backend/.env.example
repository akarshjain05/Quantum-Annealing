# Copy to .env and adjust. The app runs with zero changes to this file
# (SQLite, no LLM key) - these are for production/Postgres/LLM upgrades.

APP_NAME=NostroQ
ENV=development

# Auth - CHANGE THIS before any real deployment
SECRET_KEY=dev-only-secret-CHANGE-ME-before-any-real-deployment

# Database. Default: zero-setup local SQLite file.
# For Postgres (recommended for production / docker-compose):
#   DATABASE_URL=postgresql+psycopg2://nostroq:nostroq@localhost:5432/nostroq
DATABASE_URL=sqlite:///./nostroq.db

# Optional agent LLM phrasing enhancement - the agent is fully functional
# with all of these left blank (see app/agent/orchestrator.py).
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

DEMO_MODE=true
RANDOM_SEED=42
